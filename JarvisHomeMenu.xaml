<Window x:Class="JARVIS_1_0.JarvisHomeMenu"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="J.A.R.V.I.S."
Height="500"
Width="850"
MinHeight="450"
MinWidth="700"
WindowStartupLocation="CenterScreen"
Background="#050A12"
Foreground="White">

    <Window.Resources>

        <!-- Cyan-Farben für das HUD -->
        <SolidColorBrush x:Key="CyanBrush"
                         Color="#00E5FF"/>

        <!-- Design für den Launch-Button -->
        <Style x:Key="HudButton"
               TargetType="Button">

            <Setter Property="Height" Value="55"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="Background" Value="#101F2B"/>
            <Setter Property="BorderBrush" Value="#00BFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#123746"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#80F5FF"/>
                </Trigger>
            </Style.Triggers>

        </Style>

    </Window.Resources>

    <Grid>

        <!-- Dunkler, futuristischer Hintergrund -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="#03060B"
                              Offset="0"/>
                <GradientStop Color="#0A1724"
                              Offset="0.5"/>
                <GradientStop Color="#02070D"
                              Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Äußerer HUD-Rahmen -->
        <Border Margin="18"
                BorderBrush="#164B5B"
                BorderThickness="1"
                CornerRadius="8"
                Background="#080F18"/>

        <!-- Dezente cyanfarbene Rahmenakzente -->
        <Border Margin="0"
                        BorderBrush="#00BFFF"
                        BorderThickness="2,0,0,0"
                        VerticalAlignment="Top"
                        Height="3"
                        HorizontalAlignment="Stretch"/>

        <StackPanel Orientation="Vertical"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="400">

            <!-- JARVIS-Titel -->
            <TextBlock Text="J.A.R.V.I.S."
                               Foreground="#00E5FF"
                               FontSize="42"
                               FontWeight="Bold"
                               HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect
                                    Color="#00BFFF"
                                    BlurRadius="22"
                                    ShadowDepth="0"
                                    Opacity="0.65"/>
                </TextBlock.Effect>
            </TextBlock>
            <!-- Systemstatus -->
            <StackPanel Orientation="Vertical"
HorizontalAlignment="Center"
Margin="0,0,0,25">

                <!-- Status über der Uhr -->
                <StackPanel Orientation="Horizontal"
HorizontalAlignment="Center"
Margin="0,0,0,8">

                    <Ellipse Width="8"
Height="8"
Fill="#00E5FF"
VerticalAlignment="Center"
Margin="0,0,10,0"/>

                    <TextBlock Text="SYSTEM ONLINE"
Foreground="#75DCEB"
FontSize="12"
FontWeight="SemiBold"
VerticalAlignment="Center"/>

                </StackPanel>

                <!-- Live-Uhr -->
                <TextBlock x:Name="ClockText"
Text="00:00:00"
Foreground="#00E5FF"
FontSize="20"
FontWeight="SemiBold"
HorizontalAlignment="Center"
Margin="0,0,0,0"/>

                <!-- Datum unter der Uhr -->
                <TextBlock x:Name="DateText"
Text="30. September 2026"
Foreground="#75DCEB"
FontSize="12"
HorizontalAlignment="Center"
Margin="0,0,0,0"/>

            </StackPanel>



                <!-- Trennlinie -->
            <Border Width="180"
                            Height="1"
                            Background="#00BFFF"
                            HorizontalAlignment="Center"
                            Margin="0,18,0,18"/>

            <!-- Untertitel -->
            <TextBlock Text="STARK INDUSTRIES"
                               Foreground="#A6C9D6"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

            <TextBlock Text="PERSONAL AI CONTROL SYSTEM"
                               Foreground="#527D8D"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,7,0,35"/>

            <!-- Launch-Button -->
            <Button Content="▶ LAUNCH J.A.R.V.I.S."
                            Style="{StaticResource HudButton}"
                            Click="ChatButton_Click"/>

            <!-- Fußzeile -->
            <TextBlock Text="J.A.R.V.I.S. // INTERFACE 2.0"
                               Foreground="#416777"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,30,0,0"/>

        </StackPanel>

        <!-- Kleine HUD-Ecken -->
        <Border Width="35"
                        Height="35"
                        BorderBrush="#00BFFF"
                        BorderThickness="1,1,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="12"/>

        <Border Width="35"
                        Height="35"
                        BorderBrush="#00BFFF"
                        BorderThickness="0,0,1,1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="12"/>

    </Grid>

</Window>
